'use client'; // Next.js এ স্টেট (useState) ব্যবহারের জন্য এটা লাগবে

import React, { useState } from 'react';

// ১. ডেমো ডাটা (ছবিগুলো আপনার public ফোল্ডারে রাখতে ভুলবেন না)
const categories = [
  { id: 1, name: 'Fruit', icon: '🍎', bg: 'bg-red-100' },
  { id: 2, name: 'Grocery', icon: '🛍️', bg: 'bg-blue-100' },
  { id: 3, name: 'Ready Food', icon: '🍲', bg: 'bg-green-100' },
  { id: 4, name: 'Vegetable', icon: '🥕', bg: 'bg-yellow-100' },
];

const products = [
  { id: 1, name: 'Fresh Apples', weight: '500g', price: 120, img: '/apple.png' },
  { id: 2, name: 'Amul Milk', weight: '1L', price: 62, img: '/milk.png' },
  { id: 3, name: 'Maggi', weight: '70g', price: 14, img: '/maggi.png' },
  { id: 4, name: 'Tomatoes', weight: '500g', price: 32, img: '/tomato.png' },
];

export default function HomeUI() {
  const [cart, setCart] = useState<{ [key: number]: number }>({});

  const addToCart = (id: number) => {
    setCart((prev) => ({ ...prev, [id]: (prev[id] || 0) + 1 }));
  };

  return (
    <div className="max-w-md mx-auto bg-gray-50 min-h-screen relative pb-24 font-sans">
      {/* ================= HEADER & SEARCH ================= */}
      <div className="bg-white p-4 sticky top-0 z-10 shadow-sm">
        <div className="flex items-center justify-center gap-2 mb-4">
          <svg className="w-8 h-8 text-teal-600" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
          </svg>
          <h1 className="text-3xl font-bold text-gray-900 tracking-tight">Quickpin</h1>
        </div>
        
        <div className="relative">
          <svg className="w-5 h-5 absolute left-3 top-3 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
          <input 
            type="text" 
            placeholder="Search for groceries, food & more" 
            className="w-full pl-10 pr-4 py-3 border border-gray-200 rounded-full bg-gray-50 focus:outline-none focus:border-teal-500 text-sm"
          />
        </div>
      </div>

      {/* ================= CATEGORIES ================= */}
      <div className="flex justify-between px-4 py-6">
        {categories.map((cat) => (
          <div key={cat.id} className="flex flex-col items-center gap-2 cursor-pointer">
            <div className={`w-16 h-16 ${cat.bg} rounded-full flex items-center justify-center text-2xl shadow-sm`}>
              {cat.icon}
            </div>
            <span className="text-xs font-semibold text-gray-700">{cat.name}</span>
          </div>
        ))}
      </div>

      {/* ================= PRODUCTS ================= */}
      <div className="px-4">
        <div className="flex justify-between items-center mb-4">
          <h2 className="text-lg font-bold text-gray-900">Top picks for you</h2>
          <span className="text-sm font-semibold text-teal-600 cursor-pointer">See all &gt;</span>
        </div>

        <div className="grid grid-cols-2 gap-3">
          {products.map((product) => (
            <div key={product.id} className="bg-white p-3 rounded-2xl shadow-sm border border-gray-100 flex flex-col justify-between">
              <div className="w-full h-28 flex justify-center items-center mb-3">
                <img 
                  src={product.img} 
                  alt={product.name} 
                  className="h-full object-contain" 
                  onError={(e: any) => { e.target.style.display = 'none'; e.target.nextSibling.style.display = 'block'; }}
                />
                <span className="text-4xl hidden">{product.id === 1 ? '🍎' : product.id === 2 ? '🥛' : product.id === 3 ? '🍜' : '🍅'}</span>
              </div>
              
              <div>
                <h3 className="font-bold text-gray-800 text-sm mb-1">{product.name}</h3>
                <div className="flex justify-between items-center mt-2">
                  <span className="text-xs text-gray-500 font-medium">{product.weight} • ₹{product.price}</span>
                  <button 
                    onClick={() => addToCart(product.id)}
                    className="bg-teal-600 hover:bg-teal-700 text-white px-3 py-1.5 rounded-lg text-xs font-bold transition-colors"
                  >
                    Add +
                  </button>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      {/* ================= BOTTOM NAVIGATION ================= */}
      <div className="fixed bottom-0 left-0 right-0 max-w-md mx-auto bg-white border-t border-gray-200 flex justify-around py-3 z-20">
        <div className="flex flex-col items-center text-teal-600 cursor-pointer">
          <svg className="w-6 h-6" fill="currentColor" viewBox="0 0 20 20">
            <path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z" />
          </svg>
          <span className="text-[10px] font-bold mt-1">Home</span>
        </div>
        
        <div className="flex flex-col items-center text-gray-400 cursor-pointer hover:text-teal-600">
          <svg className="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"></path>
          </svg>
          <span className="text-[10px] font-medium mt-1">Categories</span>
        </div>

        <div className="flex flex-col items-center text-gray-400 cursor-pointer hover:text-teal-600 relative">
          <svg className="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"></path>
          </svg>
          <span className="text-[10px] font-medium mt-1">Cart</span>
          {Object.keys(cart).length > 0 && (
            <span className="absolute -top-1 -right-2 bg-red-500 text-white text-[10px] w-4 h-4 rounded-full flex items-center justify-center">
              {Object.values(cart).reduce((a, b) => a + b, 0)}
            </span>
          )}
        </div>

        <div className="flex flex-col items-center text-gray-400 cursor-pointer hover:text-teal-600">
          <svg className="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
          </svg>
          <span className="text-[10px] font-medium mt-1">Profile</span>
        </div>
      </div>
    </div>
  );
}
